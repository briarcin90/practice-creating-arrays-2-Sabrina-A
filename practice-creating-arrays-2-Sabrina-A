// Building Arrays | Lesson 2
// Practice: Creating Arrays 2

// Task 1: Initialize the Array
let greetings = new Array(7);
greetings.fill("Hello");

console.log(greetings);

// Task 2: Update Part of the Array
// Change the first 3 slots to "Hi"
greetings.fill("Hi", 0, 3);

console.log(greetings);

// Task 3: Populate an Array with a for Loop
let numbers = new Array(5);

for (let i = 0; i < numbers.length; i++) {
  numbers[i] = i * 10;
}

console.log(numbers);
